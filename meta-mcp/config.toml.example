# meta-mcp configuration
# Copy to config.toml and edit to match your environment.
#
# Each [[mcps]] entry defines one sub-MCP:
#   name        — identifier used in describe_mcp / call_mcp
#   description — one-line summary shown in list_mcps (keep it short)
#   command     — shell command list to start the sub-MCP server

[[mcps]]
name = "oscilloscope"
description = "oscilloscope waveform capture"
command = ["python", "-m", "nakoscope_mcp"]

[[mcps]]
name = "ollama"
description = "local LLM inference"
command = ["npx", "-y", "@ollama/mcp"]

[[mcps]]
name = "image-gen"
description = "image generation & editing (fal.ai FLUX.2)"
command = ["uv", "--directory", "/path/to/mcps/falai-mcp", "run", "falai-mcp"]
env = {AWS_PROFILE = "your-profile", AWS_REGION = "eu-west-2"}

[[mcps]]
name = "alexa"
description = "Alexa announcements and speech on the Echos"
command = ["uv", "--directory", "/path/to/mcps/alexa-mcp", "run", "alexa-mcp"]
# Defaults to prod (profile nakom.is). Set ALEXA_AWS_PROFILE = "nakom.is-sandbox" for sandbox.
env = {ALEXA_DEFAULT_DEVICES = "Martin's Kitchen Echo Dot,Martin's Echo Show,Bedroom Echo"}

# Blender, through the "MCP for Blender" add-on (github.com/ahujasid/blender-mcp).
# Install the add-on from the SAME release as the pinned server: its addon.py,
# as <Blender support dir>/<version>/scripts/addons/blender_mcp.py. Then, in
# Blender, enable it (Preferences > Add-ons) and click Start MCP Server (3D view,
# N panel > MCP for Blender). It listens on localhost:9876 with no auth, and
# execute_blender_code runs any Python: save the .blend first.
# Tested: 2.1.1 with Blender 4.5 (mu), 2.1.9 with Blender 5.2 (phi).
[[mcps]]
name = "blender"
description = "drive Blender: scenes, objects, materials, Python"
command = ["uvx", "mcp-for-blender==2.1.9"]
env = {DISABLE_TELEMETRY = "true"}

# midichlorian: queue and gate Ansible playbook runs on the home servers.
# MIDICHLORIAN_INSTANCES is name=url,name=url (the first is the primary).
# CLAUDE_SESSION_NAME reaches the MCP only if exported to meta-mcp; else requester is session-<pid>.
[[mcps]]
name = "midichlorian"
description = "queue and run Ansible playbooks on the home servers"
command = ["uv", "--directory", "/path/to/mcps/midichlorian", "run", "midichlorian-mcp"]
env = {MIDICHLORIAN_INSTANCES = "mace=http://<mace-ip>:9140,cere=http://<cere-ip>:9140", MIDICHLORIAN_TOKEN = "<api-token>"}
